{
  "name": "@labelzoom/mcp",
  "version": "0.2.0",
  "description": "MCP server for LabelZoom: convert, preview and print barcode labels (ZPL, EPL, CPCL and other printer languages, BarTender, NiceLabel and DYMO files, PDF and images) from Claude and other MCP clients",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "labelzoom",
    "zpl",
    "epl",
    "cpcl",
    "barcode",
    "label",
    "thermal-printer",
    "bartender",
    "nicelabel"
  ],
  "license": "MIT",
  "author": {
    "name": "RJF Technology Solutions LLC",
    "email": "support@labelzoom.com"
  },
  "homepage": "https://github.com/labelzoom/labelzoom-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labelzoom/labelzoom-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/labelzoom/labelzoom-mcp/issues"
  },
  "type": "module",
  "bin": {
    "labelzoom-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "tsc && node --test dist/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@labelzoom/sdk": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
